+import torch
+import torch.nn as nn
+
+
+class MazeMappingDQN(nn.Module):
+    def __init__(self, ir_sensor_dim, ultrasonic_dim, compass_dim, n_actions):
+        super(MazeMappingDQN, self).__init__()
+
+        self.ir_processor = nn.Sequential(
+            nn.Linear(ir_sensor_dim, 32),
+            nn.ReLU()
+        )
+
+        self.ultrasonic_processor = nn.Sequential(
+            nn.Linear(ultrasonic_dim, 16),
+            nn.ReLU()
+        )
+
+        self.compass_processor = nn.Sequential(
+            nn.Linear(compass_dim, 16),
+            nn.ReLU()
+        )
+
+        self.fc_combined = nn.Sequential(
+            nn.Linear(32 + 16 + 16, 64),
+            nn.ReLU(),
+            nn.Linear(64, n_actions)
+        )
+
+    def forward(self, ir_input, ultrasonic_input, compass_input):
+        ir_feat = self.ir_processor(ir_input)
+        ultrasonic_feat = self.ultrasonic_processor(ultrasonic_input)
+        compass_feat = self.compass_processor(compass_input)
+
+        combined_feat = torch.cat([ir_feat, ultrasonic_feat, compass_feat], dim=-1)
+        q_values = self.fc_combined(combined_feat)
+
+        return q_values
